// Generated into src so Nest compiles it with the app. Run `npx prisma
// generate` after a fresh install or a schema change.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL is in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  EXECUTOR
  BOTH
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// The fixed lists of job categories and places. The frontend shows each
// value by its Bosnian name.
enum ListingCategory {
  LAWN_MOWING
  CAR_WASH
  MOVING
  IT_HELP
  CLEANING
  ASSEMBLY
  DELIVERY
  OTHER
}

enum ListingLocation {
  SARAJEVO
  ILIDZA
  STUP
  VOGOSCA
  MOSTAR
  BANJA_LUKA
  TUZLA
  ZENICA
}

// Only OPEN jobs take applications. The client closes a job when it is
// taken, and can open it again.
enum ListingStatus {
  OPEN
  CLOSED
}

enum SessionRevocationReason {
  LOGOUT
  PASSWORD_RESET
  TOKEN_REUSE
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  fullName        String
  role            UserRole  @default(BOTH)

  emailVerificationCodeHash  String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?
  emailVerificationAttempts  Int       @default(0)

  passwordResetCodeHash  String?
  passwordResetExpiresAt DateTime?
  passwordResetSentAt    DateTime?
  passwordResetAttempts  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings     Listing[]     @relation("UserListings")
  applications Application[] @relation("UserApplications")
  sessions     Session[]
}

// One signed-in browser or device. It ends at expiresAt even when it stays
// in use, so a stolen session cannot be kept alive forever.
model Session {
  id            String                   @id @default(cuid())
  userId        String
  userAgent     String?
  createdAt     DateTime                 @default(now())
  lastUsedAt    DateTime                 @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason SessionRevocationReason?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

// Every refresh exchanges the presented token for a new one. Used tokens are
// kept until they expire: presenting one again means it was copied, and the
// whole session is revoked.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Prices are whole KM. A null price is agreed later.
model Listing {
  id          String          @id @default(cuid())
  title       String
  category    ListingCategory
  location    ListingLocation
  status      ListingStatus   @default(OPEN)
  budget      Int?
  description String?

  clientId String
  client   User   @relation("UserListings", fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

model Application {
  id         String @id @default(cuid())
  listingId  String
  executorId String

  message       String
  proposedPrice Int?
  status        ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  executor User    @relation("UserApplications", fields: [executorId], references: [id], onDelete: Cascade)

  @@unique([listingId, executorId]) // jedan executor može jednom aplicirati na isti oglas
  @@index([listingId, status])
  @@index([executorId, createdAt])
}
