generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  EXECUTOR
  BOTH
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SessionRevocationReason {
  LOGOUT
  PASSWORD_RESET
  TOKEN_REUSE
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  fullName        String
  role            UserRole  @default(BOTH)

  emailVerificationCodeHash  String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?
  emailVerificationAttempts  Int       @default(0)

  passwordResetCodeHash  String?
  passwordResetExpiresAt DateTime?
  passwordResetSentAt    DateTime?
  passwordResetAttempts  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings     Listing[]     @relation("UserListings")
  applications Application[] @relation("UserApplications")
  sessions     Session[]
}

// One signed-in browser or device. It ends at expiresAt even when it stays
// in use, so a stolen session cannot be kept alive forever.
model Session {
  id            String                   @id @default(cuid())
  userId        String
  userAgent     String?
  createdAt     DateTime                 @default(now())
  lastUsedAt    DateTime                 @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason SessionRevocationReason?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

// Every refresh exchanges the presented token for a new one. Used tokens are
// kept until they expire: presenting one again means it was copied, and the
// whole session is revoked.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Listing {
  id          String  @id @default(cuid())
  title       String
  category    String
  location    String
  budget      String?
  description String?

  clientId String
  client   User   @relation("UserListings", fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Application {
  id         String @id @default(cuid())
  listingId  String
  executorId String

  message       String
  proposedPrice String?
  status        ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  executor User    @relation("UserApplications", fields: [executorId], references: [id], onDelete: Cascade)

  @@unique([listingId, executorId]) // jedan executor može jednom aplicirati na isti oglas
  @@index([listingId, status])
  @@index([executorId, createdAt])
}
