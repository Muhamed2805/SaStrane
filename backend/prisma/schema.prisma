// Generated into src so Nest compiles it with the app. Run `npx prisma
// generate` after a fresh install or a schema change.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL is in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  EXECUTOR
  BOTH
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// The fixed lists of job categories and places. The frontend shows each
// value by its Bosnian name.
enum ListingCategory {
  LAWN_MOWING
  CAR_WASH
  MOVING
  IT_HELP
  CLEANING
  ASSEMBLY
  DELIVERY
  OTHER
}

enum ListingLocation {
  SARAJEVO
  ILIDZA
  STUP
  VOGOSCA
  MOSTAR
  BANJA_LUKA
  TUZLA
  ZENICA
}

// Only OPEN jobs take applications. The client closes a job when it is
// taken, and can open it again.
enum ListingStatus {
  OPEN
  CLOSED
}

enum SessionRevocationReason {
  LOGOUT
  PASSWORD_RESET
  PASSWORD_CHANGE
  TOKEN_REUSE
  SUSPENDED
}

// What a notification is about. Messages have their own unread count.
enum NotificationType {
  INVITATION
  NEW_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  NEW_RATING
}

enum ReportReason {
  SPAM
  SCAM
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  emailVerifiedAt    DateTime?
  passwordHash       String
  fullName           String
  role               UserRole          @default(BOTH)
  // Emails about new applications, decisions and unread messages. Account
  // security emails are always sent.
  emailNotifications Boolean           @default(true)
  // A short introduction and the kinds of jobs the user does, both shown
  // on the public profile.
  bio                String?
  skills             ListingCategory[] @default([])
  // Where the user does jobs. Clients find executors by it.
  location           ListingLocation?
  // The current profile photo. Its file lives in S3 storage under a key
  // made from the user and avatar IDs (see src/auth/avatar.ts).
  avatarId           String?
  // Admins handle reports. Set with `npm run admin`.
  isAdmin            Boolean           @default(false)
  // A suspended user cannot sign in. Suspending ends every session.
  suspendedAt        DateTime?

  emailVerificationCodeHash  String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?
  emailVerificationAttempts  Int       @default(0)

  passwordResetCodeHash  String?
  passwordResetExpiresAt DateTime?
  passwordResetSentAt    DateTime?
  passwordResetAttempts  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings              Listing[]      @relation("UserListings")
  applications          Application[]  @relation("UserApplications")
  sessions              Session[]
  clientConversations   Conversation[] @relation("ClientConversations")
  executorConversations Conversation[] @relation("ExecutorConversations")
  sentMessages          Message[]      @relation("SentMessages")
  receivedRatings       Rating[]       @relation("ReceivedRatings")
  givenRatings          Rating[]       @relation("GivenRatings")
  savedListings         SavedListing[]
  invitations           Invitation[]
  notifications         Notification[]
  reportsSent           Report[]       @relation("ReportsSent")
  reportsReceived       Report[]       @relation("ReportsReceived")
  reportsHandled        Report[]       @relation("ReportsHandled")
}

// One signed-in browser or device. It ends at expiresAt even when it stays
// in use, so a stolen session cannot be kept alive forever.
model Session {
  id            String                   @id @default(cuid())
  userId        String
  userAgent     String?
  createdAt     DateTime                 @default(now())
  lastUsedAt    DateTime                 @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason SessionRevocationReason?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

// Every refresh exchanges the presented token for a new one. Used tokens are
// kept until they expire: presenting one again means it was copied, and the
// whole session is revoked.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Prices are whole KM. A null price is agreed later.
model Listing {
  id          String          @id @default(cuid())
  title       String
  category    ListingCategory
  location    ListingLocation
  status      ListingStatus   @default(OPEN)
  budget      Int?
  description String?

  clientId String
  client   User   @relation("UserListings", fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications  Application[]
  conversations Conversation[]
  ratings       Rating[]
  photos        ListingPhoto[]
  savedBy       SavedListing[]
  invitations   Invitation[]
  notifications Notification[]
  reports       Report[]

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

// A client asks a user who does jobs to apply to one of their open jobs.
// One invitation per job and user. The user applies as usual or declines,
// which deletes it. Deleting the job or the user deletes it too.
model Invitation {
  id         String   @id @default(cuid())
  listingId  String
  executorId String
  createdAt  DateTime @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  executor User    @relation(fields: [executorId], references: [id], onDelete: Cascade)

  @@unique([listingId, executorId])
  @@index([executorId, createdAt])
}

// Something that happened to the user, shown under the bell in the navbar.
// The job title and the other person's name are copied, so the text stays
// when the job is deleted or the name changes.
model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  // Null once the job is deleted.
  listingId    String?
  listingTitle String
  // The user who caused it: the client, the executor or the rater.
  actorName    String
  // Null until the user opens it or marks all as read.
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([listingId])
}

// A job the user marked to come back to later.
model SavedListing {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model Application {
  id         String @id @default(cuid())
  listingId  String
  executorId String

  message       String
  proposedPrice Int?
  status        ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  executor User    @relation("UserApplications", fields: [executorId], references: [id], onDelete: Cascade)
  rating   Rating?

  @@unique([listingId, executorId]) // jedan executor može jednom aplicirati na isti oglas
  @@index([listingId, status])
  @@index([executorId, createdAt])
}

// One conversation per job and user. A user writes to a job's client, or
// the client writes to a user who applied. Deleting the job deletes it.
model Conversation {
  id         String @id @default(cuid())
  listingId  String
  // The job's client, kept here so each side's list is one indexed query.
  clientId   String
  // The other side: the user who asked about the job or applied to it.
  executorId String

  // Null until the first message. Conversations without messages are not
  // listed.
  lastMessageId String?   @unique
  lastMessageAt DateTime?

  // The messages each side has not read yet.
  clientUnread   Int @default(0)
  executorUnread Int @default(0)

  // When each side's oldest unread message arrived, and when that side got
  // an email about it. Reading the conversation clears both, so each side
  // gets at most one email until they read it.
  clientUnreadSince   DateTime?
  executorUnreadSince DateTime?
  clientEmailedAt     DateTime?
  executorEmailedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  client      User      @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  executor    User      @relation("ExecutorConversations", fields: [executorId], references: [id], onDelete: Cascade)
  lastMessage Message?  @relation("LastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  messages    Message[] @relation("ConversationMessages")

  @@unique([listingId, executorId])
  @@index([clientId, lastMessageAt])
  @@index([executorId, lastMessageAt])
  @@index([clientUnreadSince])
  @@index([executorUnreadSince])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation  Conversation  @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  lastMessageOf Conversation? @relation("LastMessage")

  @@index([conversationId, createdAt])
}

// A client's rating of the executor they accepted, given once the job is
// closed. One per application, and final. It outlives the job: deleting the
// job clears applicationId and listingId, and listingTitle keeps the name.
model Rating {
  id            String  @id @default(cuid())
  applicationId String? @unique
  listingId     String?
  listingTitle  String
  clientId      String
  executorId    String
  score         Int // 1 to 5
  comment       String?

  createdAt DateTime @default(now())

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  client      User         @relation("GivenRatings", fields: [clientId], references: [id], onDelete: Cascade)
  executor    User         @relation("ReceivedRatings", fields: [executorId], references: [id], onDelete: Cascade)

  @@index([executorId, createdAt])
  @@index([listingId])
}

// A report about a job or a user. reportedUserId is the user, or the job's
// client. Deleting the job clears listingId, and listingTitle keeps the name.
model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  listingId      String?
  listingTitle   String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  handledById    String?
  handledAt      DateTime?

  createdAt DateTime @default(now())

  reporter     User     @relation("ReportsSent", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  handledBy    User?    @relation("ReportsHandled", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([listingId])
  @@index([handledById])
}

// A photo of a job, at most five per job. The image files live in S3
// storage under keys made from the job and photo IDs (see
// src/listings/photos/photo-keys.ts). The lowest position is the cover.
model ListingPhoto {
  id        String  @id
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position  Int
  // The size of the large image, after resizing.
  width     Int
  height    Int

  createdAt DateTime @default(now())

  @@index([listingId, position])
}
