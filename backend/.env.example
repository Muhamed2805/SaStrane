DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# At least 32 characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change_me"
# Access token lifetime: a number followed by s, m, h or d. Defaults to 15m.
# The frontend refreshes the token every 10 minutes, so keep it above that.
JWT_EXPIRES_IN="15m"
PORT=4000
NODE_ENV=development
# Comma-separated frontend origins required in production.
CORS_ORIGINS="http://localhost:3000"

# Transactional email (Resend). In development, missing credentials fall back
# to printing one-time email codes in the backend terminal.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="SaStrane <noreply@your-domain.com>"
# At least 32 characters in production, and different from JWT_SECRET.
EMAIL_VERIFICATION_SECRET="use_a_different_long_random_secret"
