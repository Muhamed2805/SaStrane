DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="change_me"
JWT_EXPIRES_IN="15m"
PORT=4000
NODE_ENV=development
# Comma-separated frontend origins required in production.
CORS_ORIGINS="http://localhost:3000"

# Transactional email (Resend). In development, missing credentials fall back
# to printing the verification code in the backend terminal.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="SaStrane <noreply@your-domain.com>"
EMAIL_VERIFICATION_SECRET="use_a_different_long_random_secret"
