# The database from docker-compose.yml (`docker compose up -d` in the
# repository root). For a hosted database such as Neon, add
# ?sslmode=verify-full so the server certificate is checked.
DATABASE_URL="postgresql://sastrane:sastrane@localhost:5432/sastrane"
# The e2e tests empty every table, so they use their own database, which they
# create when it is missing. The name must end with _test.
# TEST_DATABASE_URL="postgresql://sastrane:sastrane@localhost:5432/sastrane_test"
# At least 32 characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change_me"
# Access token lifetime: a number followed by s, m, h or d. Defaults to 15m.
# The frontend gets a new token when one is rejected, so short is fine.
JWT_EXPIRES_IN="15m"
PORT=4000
NODE_ENV=development
# Comma-separated frontend origins required in production.
CORS_ORIGINS="http://localhost:3000"
# How many proxies in front of the API append to X-Forwarded-For. Rate limits
# use the client IP, so count only hops that set the header themselves: 1 for
# the API host's load balancer, plus 1 when browsers come through the
# frontend's /api proxy on a host that sets it (Vercel does; plain
# `next start` passes the client's value on unchecked, so do not count it).
# Defaults to 1 in production and 0 otherwise.
# TRUST_PROXY_HOPS=1

# Transactional email (Resend). Required in production. In development, leave
# the key empty and the backend prints one-time email codes in its terminal.
RESEND_API_KEY=""
EMAIL_FROM="SaStrane <noreply@your-domain.com>"
# At least 32 characters in production, and different from JWT_SECRET.
EMAIL_VERIFICATION_SECRET="use_a_different_long_random_secret"
